# Copy this file to .env and fill in real values. Never commit .env to git.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
TELEGRAM_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Closed-pilot default: existing roster entries work, unknown users cannot self-register.
# Set to true only when you intentionally want automatic onboarding enabled.
ALLOW_AUTO_ENROLL=false
