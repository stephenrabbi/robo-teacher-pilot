# Copy this file to .env and fill in real values. Never commit .env to git.

# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-3.1-flash-lite if not set
GEMINI_MODEL=gemini-3.1-flash-lite

# The Sheet ID is the long string in your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=

# Paste the FULL contents of your service account JSON key file here,
# as a single line (most editors can do this automatically).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Get this from @BotFather on Telegram (see README)
TELEGRAM_BOT_TOKEN=

# Get these from your Twilio Console dashboard (Account Info section,
# right on the homepage after logging in)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
